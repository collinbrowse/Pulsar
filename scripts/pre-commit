#!/bin/bash

# Pre-commit hook for SwiftLint
# Runs SwiftLint on staged Swift files before commit
# This hook is installed via scripts/setup-git-hooks.sh

# Get staged Swift files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=AM | grep "\.swift$")

# If no Swift files staged, skip
if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# Check if SwiftLint is installed
if ! command -v swiftlint &> /dev/null; then
  echo "⚠️  SwiftLint not installed. Install with: brew install swiftlint"
  echo "⚠️  Skipping pre-commit check. Consider installing SwiftLint."
  exit 0  # Don't block commit if SwiftLint not installed
fi

echo "🔍 Running SwiftLint on staged files..."

# Run SwiftLint on staged files
swiftlint lint --strict $STAGED_FILES
LINT_RESULT=$?

if [ $LINT_RESULT -ne 0 ]; then
  echo ""
  echo "❌ SwiftLint found violations. Commit blocked."
  echo ""
  echo "💡 To fix:"
  echo "   1. Run: swiftlint --fix"
  echo "   2. Review changes: git diff"
  echo "   3. Stage fixes: git add ."
  echo "   4. Commit again: git commit"
  echo ""
  exit 1  # Block the commit
fi

# Try to auto-fix what we can (non-blocking)
echo "✨ Auto-fixing issues where possible..."
swiftlint --fix $STAGED_FILES 2>/dev/null || true

# Re-stage any auto-fixed files
FIXED_FILES=$(git diff --name-only --diff-filter=AM | grep "\.swift$")
if [ -n "$FIXED_FILES" ]; then
  echo "📝 Re-staging auto-fixed files..."
  git add $FIXED_FILES
fi

echo "✅ SwiftLint passed! Proceeding with commit..."
exit 0





